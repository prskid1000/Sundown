<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nocturne_bg">#FF161826</color>

    <!-- Dark-only; the bg token is the window background so there is no white
         flash before Compose draws. -->
    <style name="Theme.Sundown" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nocturne_bg</item>
        <item name="android:navigationBarColor">@color/nocturne_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
